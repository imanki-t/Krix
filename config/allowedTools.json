    "get_file_contents": { "enabled": true, "category": "core", "permission": "READ_ONLY", "description": "Reads file" },
    "str_replace_editor": { "enabled": true, "category": "core", "permission": "MUTATING", "description": "Replaces text in file" },
    "create_or_update_file": { "enabled": true, "category": "core", "permission": "MUTATING", "description": "Creates or updates file" },
    "delete_file": { "enabled": true, "category": "core", "permission": "MUTATING", "description": "Deletes file" },
    "grep": { "enabled": true, "category": "core", "permission": "READ_ONLY", "description": "Searches regex pattern" },
    "view_file_outline": { "enabled": true, "category": "core", "permission": "READ_ONLY", "description": "Extracts AST outline" },
    "git_tree": { "enabled": true, "category": "core", "permission": "READ_ONLY", "description": "Lists file tree" },
