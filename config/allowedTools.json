    "search_code": { "enabled": true, "category": "core", "permission": "READ_ONLY", "description": "Searches code" },
    "search_repositories": { "enabled": true, "category": "core", "permission": "READ_ONLY", "description": "Searches repos" },
    "sandbox_status": { "enabled": true, "category": "core", "permission": "READ_ONLY", "description": "Inspects sandbox" },
