# =============================================================================
# Krix — environment configuration
#
# Copy this file to `.env` for local development, or paste these into your
# host's environment-variable / secrets UI (Render → Environment) for
# production. Never commit a real `.env` file — it's already git-ignored.
# =============================================================================


# ── Server ───────────────────────────────────────────────────────────────────

# Set to "production" when deployed. This turns on stricter startup checks
# (a real MCP_API_KEY, an HTTPS PUBLIC_BASE_URL) and Strict-Transport-Security.
# Leave unset for local development.
NODE_ENV=production

# Port the HTTP server listens on.
PORT=3000

# The public HTTPS URL Krix is reachable at. Required in production — it's
# used to build OAuth endpoint URLs, the logo URL, and to validate the
# request Origin header. Example: https://krix.onrender.com
PUBLIC_BASE_URL=https://your-app.onrender.com


# ── Gateway access key ───────────────────────────────────────────────────────

# The master secret for this Krix instance. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# This is the "access key" typed into the OAuth authorize page, and (if
# ALLOW_LEGACY_API_KEY=true) also accepted directly as a Bearer token or
# x-api-key header. Never reuse a short or guessable value.
MCP_API_KEY=replace-with-a-64-character-random-secret


# ── Provider credentials (server-side) ──────────────────────────────────────

# GitHub personal access token used by GitHub tools when the client doesn't
# supply its own (see ALLOW_CLIENT_CREDENTIAL_HEADERS below).
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here
# Alternative alias, either name works:
# GITHUB_PAT=ghp_your_github_token_here

# Render API key used by Render tools when the client doesn't supply its own.
RENDER_API_KEY=rnd_your_render_api_key_here
# Alternative alias, either name works:
# RENDER_PAT=rnd_your_render_api_key_here


# ── OAuth / connector branding ──────────────────────────────────────────────

# Display name shown on the OAuth "Authorize access" consent screen and in
# OAuth discovery metadata (what Claude/Gemini/ChatGPT show when linking).
APP_NAME=Krix

# Optional external logo URL. Leave blank to use the bundled logo served at
# {PUBLIC_BASE_URL}/logo.png (assets/logo.png in this repo) — this is the
# fix for the "logo doesn't show on the account-linking screen" issue: make
# sure PUBLIC_BASE_URL is correct and reachable over HTTPS, since that is
# what connectors fetch the logo from. If you do set this, it must be a
# reachable HTTPS URL (or same-origin).
APP_LOGO_URL=


# ── Authentication modes ─────────────────────────────────────────────────────

# OAuth 2.1 + PKCE (the /oauth/* endpoints) is always available and is what
# connector "Link account" flows (Claude, Gemini, ChatGPT, etc.) use — the
# access key you enter there is MCP_API_KEY above.
#
# ALLOW_LEGACY_API_KEY additionally lets a client send MCP_API_KEY directly
# as `Authorization: Bearer <key>` or `x-api-key: <key>`, skipping the OAuth
# dance entirely. This is convenient for simple/manual setups (curl, custom
# scripts, clients without OAuth support) and is exactly as secure as OAuth
# here since both are gated on the same MCP_API_KEY — it's a convenience
# toggle, not a security downgrade. Set to false to force OAuth-only if you
# want rotatable/revocable per-client tokens instead of one shared key.
ALLOW_LEGACY_API_KEY=true

# Allow MCP clients to supply their own GitHub/Render credentials via
# x-github-token / x-render-token headers, overriding the server-side
# credentials above on a per-request basis. Useful if different agents/users
# of this gateway should act as different GitHub/Render identities. Keep this
# false unless you specifically need that, since it lets any authenticated
# client route arbitrary bearer tokens through this server.
ALLOW_CLIENT_CREDENTIAL_HEADERS=false

# OAuth access tokens (issued by the "Authorize access" flow) live only in
# memory and are wiped on every restart/redeploy — without this, a redeploy
# on Render forces every already-linked client (Claude, Gemini, ChatGPT...)
# to redo the interactive authorization screen. Set this to a long random
# value and Krix will hand it out as a standard OAuth refresh_token: a
# compliant client stores it and automatically exchanges it for a fresh
# access_token whenever the old one expires or a redeploy invalidates it —
# no more re-authenticating by hand. Generate one the same way as
# MCP_API_KEY and keep it just as private. Leave blank to disable (clients
# fall back to re-authorizing manually, as before).
MCP_REFRESH_TOKEN=


# ── MCP session / request limits ─────────────────────────────────────────────

MAX_MCP_SESSIONS=100
MCP_RATE_LIMIT=120
MCP_BODY_LIMIT=5mb
MCP_SESSION_IDLE_MS=600000
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000

# Optional comma-separated list of extra allowed CORS/Origin values, beyond
# PUBLIC_BASE_URL (which is always allowed). Most deployments can leave this
# blank.
MCP_ALLOWED_ORIGINS=

# Trust the platform's reverse-proxy headers (X-Forwarded-*) for client IP /
# protocol detection. Render, Fly.io, and most PaaS hosts need this as-is.
# Set to false only if you're running with no reverse proxy in front of you.
TRUST_PROXY=true


# ── Tool availability ─────────────────────────────────────────────────────────

# Set true to enable every tool category regardless of the flags below.
ENABLE_ALL_TOOLS=false

ENABLE_GITHUB_ISSUES_PRS=false
ENABLE_GITHUB_ADMIN=false
ENABLE_RENDER=false
# Sandbox + local git tools are on by default — see the Sandbox section below
# for the isolation mode that actually powers them.
ENABLE_SANDBOX=true


# ── Sandbox isolation ─────────────────────────────────────────────────────────
#
# Sandbox tools (sandbox_exec, sandbox_run, sandbox_install, git_clone's local
# checkout, etc.) execute inside `bwrap` (bubblewrap) for real OS-level
# isolation from the rest of the container: a read-only view of the system,
# no access to other sessions' files, and network access only for the
# specific operations that need it (installs, git).
#
# IMPORTANT: bwrap needs the kernel to allow unprivileged user namespaces.
# Some hosting platforms (Render web services, Cloud Run, and other managed
# containers) block this by default even though bwrap itself is installed —
# bwrap will fail with a namespace-permission error and, without the fallback
# below, sandbox tools would simply stop working with no obvious explanation.
#
# Krix probes this automatically at runtime:
#   - If bwrap works in your environment, it's used — no action needed.
#   - If it doesn't, and ALLOW_UNSAFE_HOST_SANDBOX=true, Krix automatically
#     falls back to running sandbox commands directly in this container
#     (still isolated from your host machine by Docker, just not further
#     isolated by bwrap namespaces) and logs a one-time warning.
#   - If it doesn't, and ALLOW_UNSAFE_HOST_SANDBOX=false, sandbox tools
#     return a clear error explaining exactly what to change.
#
# Recommended default: leave both as-is below. This gives you real bwrap
# isolation on hosts that support it, and a working (if less isolated)
# sandbox everywhere else — including Render — instead of broken tools.
SANDBOX_MODE=bwrap
ALLOW_UNSAFE_HOST_SANDBOX=true

# Arbitrary sandboxed commands (sandbox_exec/sandbox_run/persistent shell)
# have no network access by default, even in host-fallback mode, as
# defense-in-depth. install_packages and the git_* tools always get network
# regardless of this flag, since they need it to function. Set to true to
# give sandboxed commands unrestricted network access (matches pre-hardening
# behavior, more convenient, less isolated).
SANDBOX_NETWORK=false


# ── Session context ────────────────────────────────────────────────────────

# When true, reconnecting with the same GitHub token resumes the previous
# session's active repo/branch/sandbox directory instead of starting fresh
# every time — convenient for a single-user/personal deployment. Keep this
# false for multi-tenant deployments where different MCP sessions might
# share credentials and should stay isolated from each other.
ENABLE_CONTEXT_RESUME=true

# How long a resumable context is kept around after last use (ms).
AUTH_CONTEXT_TTL_MS=3600000
