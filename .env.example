# =========================
# Krix production configuration
# =========================
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://krix.onrender.com

# Generate a long random value. Never commit the real value.
MCP_API_KEY=replace-with-a-64-character-random-secret

# Provider credentials. Prefer server-side credentials; do not send them from clients.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_replace_me
RENDER_API_KEY=rnd_replace_me

# OAuth / connector branding
APP_NAME=Krix
# Optional. Must be HTTPS in production. Defaults to https://<host>/logo.svg
APP_LOGO_URL=

# Legacy direct API-key authentication is OFF by default. OAuth is preferred.
ALLOW_LEGACY_API_KEY=false
# Allow x-github-token / x-render-token from MCP clients only if you fully understand the risk.
ALLOW_CLIENT_CREDENTIAL_HEADERS=false

# MCP request/session controls
MAX_MCP_SESSIONS=100
MCP_RATE_LIMIT=120
MCP_BODY_LIMIT=5mb
MCP_SESSION_IDLE_MS=600000
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
# Optional comma-separated exact origins. The PUBLIC_BASE_URL origin is always allowed.
MCP_ALLOWED_ORIGINS=
TRUST_PROXY=true

# Tool availability
ENABLE_ALL_TOOLS=false
ENABLE_GITHUB_ISSUES_PRS=false
ENABLE_GITHUB_ADMIN=false
ENABLE_RENDER=false
ENABLE_SANDBOX=true

# Sandbox security. bwrap is required for production sandbox isolation.
SANDBOX_MODE=bwrap
# NEVER enable this in production unless you knowingly accept host-level arbitrary code execution.
ALLOW_UNSAFE_HOST_SANDBOX=false

# Context is isolated per MCP session by default.
ENABLE_CONTEXT_RESUME=false
AUTH_CONTEXT_TTL_MS=3600000
