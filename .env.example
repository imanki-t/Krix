# Server Port Configuration (defaults to 3000 if omitted)
PORT=3000

# Secure access key for Krix gateway. Clients must pass this via x-api-key or Authorization Bearer header.
MCP_API_KEY=your_mcp_gateway_security_key_here

# GitHub Access Token (fallback if x-github-token header is omitted by client)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here
# Alternative alias for GitHub token:
# GITHUB_PAT=ghp_your_github_token_here

# Render API Key (fallback if x-render-token header is omitted by client)
RENDER_API_KEY=rnd_your_render_api_key_here
# Alternative alias for Render token:
# RENDER_PAT=rnd_your_render_api_key_here

# Enable All Tools by default (set to 'true' to bypass lazy-loading)
ENABLE_ALL_TOOLS=false

# Category-specific Tool Flags (disabled by default, set to 'true' to enable)
ENABLE_GITHUB_ISSUES_PRS=false
ENABLE_GITHUB_ADMIN=false
ENABLE_RENDER=false

# Sandbox & Local Git Tools Flag (enabled by default, set to 'false' to disable)
ENABLE_SANDBOX=true

# Security Restriction Levels: low | medium | high (default: low)
COMMAND_RESTRICTION_LEVEL=low
NETWORK_RESTRICTION_LEVEL=low

# Require Bubblewrap isolation for sandbox processes (enabled by default)
SANDBOX_ISOLATION_REQUIRED=true

# Default network access for sandbox_exec (set to 'false' to disable)
SANDBOX_EXEC_NETWORK_DEFAULT=true

# Default network access for sandbox_run (set to 'false' to disable)
SANDBOX_RUN_NETWORK_DEFAULT=true

# Default network access for sandbox_install (set to 'false' to disable)
SANDBOX_INSTALL_NETWORK_DEFAULT=true

# Default network access for Git operations (set to 'false' to disable)
GIT_NETWORK_DEFAULT=true

# Maximum number of active MCP sessions
MAX_MCP_SESSIONS=24

# Maximum number of stored authentication contexts
MAX_AUTH_CONTEXTS=128

# Maximum background processes globally
MAX_BACKGROUND_PROCESSES=16

# Maximum background processes allowed per authentication identity
MAX_BACKGROUND_PROCESSES_PER_AUTH=8

# Maximum number of persistent shells globally
MAX_PERSISTENT_SHELLS=12

# Maximum sandbox executions running at the same time
MAX_CONCURRENT_EXECUTIONS=4

# Maximum sandbox executions waiting in the execution queue
MAX_EXECUTION_QUEUE=8

# Maximum normal sandbox execution time in ms (default: 300000 / 5m)
EXECUTION_TIMEOUT_MS=300000

# Maximum background process lifetime in ms (default: 600000 / 10m)
BACKGROUND_PROCESS_TIMEOUT_MS=600000

# Maximum number of cached command outputs globally
MAX_OUTPUT_CACHE_ENTRIES=64

# Maximum total memory used by cached command outputs in bytes
MAX_OUTPUT_CACHE_BYTES=33554432

# Maximum cached outputs retained per session
MAX_OUTPUT_CACHE_PER_SESSION=10

# Cached command output TTL in ms (default: 900000 / 15m)
OUTPUT_CACHE_TTL_MS=900000

# Maximum number of environment variables allowed per sandbox
MAX_ENV_VARS=128

# Maximum combined environment variable size in bytes
MAX_ENV_BYTES=262144

# Maximum size of a single file allowed inside the sandbox in bytes
MAX_SANDBOX_FILE_SIZE=16777216

# Maximum total sandbox storage per authentication identity in bytes
MAX_SANDBOX_SIZE=268435456

# Maximum size of a single file in push_files in bytes
MAX_PUSH_FILE_SIZE=4194304

# Maximum combined file size allowed in a single push_files operation in bytes
MAX_PUSH_TOTAL_SIZE=16777216

# Session idle cleanup TTL in ms (default: 600000 / 10m)
SESSION_IDLE_TIMEOUT_MS=600000

# Authentication context persistence TTL in ms (default: 3600000 / 1h)
AUTH_CONTEXT_TTL_MS=3600000

# Render session cache TTL in ms (default: 1800000 / 30m)
RENDER_SESSION_TTL_MS=1800000

# Maximum persistent shell output retained in memory per shell in bytes
PERSISTENT_SHELL_OUTPUT_LIMIT=1048576

# Maximum number of cached Render sessions
MAX_RENDER_SESSIONS=8

# Maximum Render response size in bytes
MAX_RENDER_RESPONSE_SIZE=8388608

# RSS memory level that triggers proactive resource cleanup in MB
MEMORY_PRESSURE_MB=360

# RSS memory level that triggers emergency resource cleanup in MB
MEMORY_EMERGENCY_MB=440

# Sandbox security level: low | medium | high (default: high)
SANDBOX_SECURITY_LEVEL=high
